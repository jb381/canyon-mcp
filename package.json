{
  "name": "canyon-mcp",
  "version": "0.1.0",
  "description": "Respectful Canyon bicycle catalog CLI and MCP server",
  "homepage": "https://github.com/jb381/canyon-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jb381/canyon-mcp.git"
  },
  "bugs": "https://github.com/jb381/canyon-mcp/issues",
  "type": "module",
  "bin": {
    "canyon": "dist/cli.js",
    "canyon-mcp": "dist/mcp.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "test:live": "bun src/cli.ts search Grail --locale en-de --limit 3 --json --refresh",
    "dev:cli": "bun src/cli.ts",
    "dev:mcp": "bun src/mcp.ts",
    "prepack": "bun run build && bun run test"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "keywords": [
    "canyon",
    "bicycles",
    "cli",
    "mcp"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
